# Copy this file to .env and fill in your own values.
# Never commit your real .env file to GitHub -- only this .example file.

# Get a free key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY= #YOUR_API_KEY

# Groq's model lineup changes fairly often. If you get a "model not found"
# error, check https://console.groq.com/docs/models for current names and
# update these two lines -- no code changes needed.
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# How many retrieved text chunks (and how many characters of each) get
# used for a plain semantic-search answer. Lower these if you hit a
# "too many tokens" error on the TEXT model.
MAX_TEXT_CHUNKS=3
MAX_CHARS_PER_CHUNK=2000

# How many explicitly-referenced pages ("explain page 4 and 6") get sent
# as images in one answer, and how large each gets shrunk to (pixels on
# its longest side) before sending. Lower these if you hit a "too many
# tokens" error on the VISION model.
MAX_PAGES_PER_ANSWER=3
MAX_IMAGE_DIMENSION=1200
MAX_CHUNKS_PER_PAPER=4